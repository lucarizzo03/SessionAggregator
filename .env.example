# Injected automatically by the Vercel Neon integration in deployed environments.
# For local dev/migrate/seed, copy this file to .env.local and fill in a Neon
# connection string (found in the Neon dashboard -> Connection Details).
DATABASE_URL=postgres://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Tavus API key, used by /api/sync to call the Tavus REST API.
# Found in the Tavus dashboard under API Keys.
TAVUS_API_KEY=

# Anthropic API key, used by /api/extract to score transcripts against a
# persona's objectives/guardrails (claude-sonnet-5, temperature 0).
# Found at console.anthropic.com under API Keys.
ANTHROPIC_API_KEY=
